{
  "name": "clauditor",
  "productName": "Clauditor",
  "version": "1.0.0",
  "description": "Clauditor — a code editor for Claude Code, connected to Claude desktop",
  "author": "Rivaldi",
  "license": "MIT",
  "homepage": "https://github.com/rivaldis159/clauditor",
  "repository": {
    "type": "git",
    "url": "https://github.com/rivaldis159/clauditor.git"
  },
  "bugs": "https://github.com/rivaldis159/clauditor/issues",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --dir --config electron-builder.yml && node scripts/installer.mjs",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "i18n": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@anthropic-ai/sdk": "^0.93.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-virtual": "3.14.19",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fuzzysort": "4.0.2",
    "lucide-react": "1.57.0",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
